{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Hand-maintained structural half of the chart schema. gen.py merges in env/envSecret validation from contract.yaml and writes chart/edspace/values.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Public hostname (PHX_HOST). Required."
        },
        "checkOrigin": { "type": "string" }
      },
      "additionalProperties": false,
      "required": ["host"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "enum": ["latest"] } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": { "type": "array" },
    "registryCredentials": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "registry": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "additionalProperties": false,
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "username": { "minLength": 1 },
          "password": { "minLength": 1 }
        },
        "required": ["username", "password"]
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "db": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "persistence": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              },
              "additionalProperties": false
            },
            "resources": { "type": "object" }
          },
          "additionalProperties": false
        },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "sslMode": { "enum": ["", "require"] },
        "existingSecret": { "type": "string" },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "password": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "autoGenerate": { "type": "boolean" },
        "secretKeyBase": { "type": "string" },
        "tokenSigningSecret": { "type": "string" },
        "releaseCookie": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "secretKeyBase": { "type": "string" },
            "tokenSigningSecret": { "type": "string" },
            "releaseCookie": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "adapter": { "enum": ["local_disk", "azure_blob"] },
        "localDisk": {
          "type": "object",
          "properties": {
            "root": { "type": "string" },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" },
                "storageClass": { "type": "string" },
                "accessModes": { "type": "array", "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] } },
                "existingClaim": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "azureBlob": {
          "type": "object",
          "properties": {
            "account": { "type": "string" },
            "container": { "type": "string" },
            "key": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "azure_blob" } } },
          "then": {
            "properties": {
              "azureBlob": {
                "properties": {
                  "account": { "minLength": 1 },
                  "container": { "minLength": 1 }
                },
                "required": ["account", "container"]
              }
            }
          }
        }
      ]
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["azure", "openai", "anthropic", "google", "groq", "mistral", "openrouter", "deepseek", "deepinfra", "cerebras", "xai", "amazon_bedrock"] },
        "apiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "baseUrl": { "type": "string" },
        "apiVersion": { "type": "string" },
        "textModel": { "type": "string" },
        "textDeployment": { "type": "string" },
        "smallModel": { "type": "string" },
        "smallDeployment": { "type": "string" },
        "embeddingModel": { "type": "string" },
        "embeddingDeployment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "mailer": {
      "type": "object",
      "properties": {
        "fromEmail": { "type": "string" },
        "fromName": { "type": "string" },
        "mailpaceApiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extraEnvFrom": { "type": "array" },
    "extraEnv": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "certManager": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "issuer": { "type": "string" },
                "issuerKind": { "enum": ["Issuer", "ClusterIssuer"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clustering": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "enum": ["Recreate", "RollingUpdate"] },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": { "type": ["integer", "string"] },
            "maxUnavailable": { "type": ["integer", "string"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "migrate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] },
        "behavior": { "type": "object" }
      },
      "additionalProperties": false,
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "$comment": "An HPA with no metrics is invalid; require at least one target.",
        "anyOf": [
          {
            "properties": { "targetCPUUtilizationPercentage": { "type": "integer" } },
            "required": ["targetCPUUtilizationPercentage"]
          },
          {
            "properties": { "targetMemoryUtilizationPercentage": { "type": "integer" } },
            "required": ["targetMemoryUtilizationPercentage"]
          }
        ]
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "automount": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "clusterDomain": { "type": "string" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "allOf": [
    {
      "$comment": "External DB mode a needs host+password; mode b needs an existing Secret URL key; mode c needs host+existing Secret.",
      "if": {
        "properties": {
          "db": {
            "properties": {
              "bundled": {
                "properties": { "enabled": { "const": false } }
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "db": {
                "properties": {
                  "host": { "minLength": 1 },
                  "password": { "minLength": 1 },
                  "existingSecret": { "maxLength": 0 }
                },
                "required": ["host", "password"]
              }
            }
          },
          {
            "properties": {
              "db": {
                "properties": {
                  "existingSecret": { "minLength": 1 },
                  "existingSecretKeys": {
                    "properties": { "url": { "minLength": 1 } },
                    "required": ["url"]
                  }
                },
                "required": ["existingSecret", "existingSecretKeys"]
              }
            }
          },
          {
            "properties": {
              "db": {
                "properties": {
                  "host": { "minLength": 1 },
                  "existingSecret": { "minLength": 1 }
                },
                "required": ["host", "existingSecret"]
              }
            }
          }
        ]
      }
    },
    {
      "$comment": "Explicit secrets are mandatory when auto-generation is off.",
      "if": {
        "properties": {
          "secrets": {
            "properties": { "autoGenerate": { "const": false } }
          }
        }
      },
      "then": {
        "properties": {
          "secrets": {
            "anyOf": [
              {
                "properties": {
                  "secretKeyBase": { "minLength": 1 },
                  "tokenSigningSecret": { "minLength": 1 }
                },
                "required": ["secretKeyBase", "tokenSigningSecret"]
              },
              {
                "properties": { "existingSecret": { "minLength": 1 } },
                "required": ["existingSecret"]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "Multiple replicas, including HPA scale-out, require clustering and either Blob storage or persistent ReadWriteMany local storage.",
      "if": {
        "anyOf": [
          { "properties": { "replicaCount": { "minimum": 2 } }, "required": ["replicaCount"] },
          {
            "properties": {
              "autoscaling": {
                "properties": {
                  "enabled": { "const": true },
                  "maxReplicas": { "minimum": 2 }
                },
                "required": ["enabled", "maxReplicas"]
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "clustering": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "storage": {
            "if": { "properties": { "adapter": { "const": "local_disk" } } },
            "then": {
              "properties": {
                "localDisk": {
                  "properties": {
                    "persistence": {
                      "properties": {
                        "enabled": { "const": true },
                        "accessModes": { "contains": { "const": "ReadWriteMany" } }
                      },
                      "required": ["enabled", "accessModes"]
                    }
                  },
                  "required": ["persistence"]
                }
              },
              "required": ["localDisk"]
            }
          }
        }
      }
    },
    {
      "$comment": "A ReadWriteOnce local uploads PVC cannot safely attach to a surge pod during rolling updates.",
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "adapter": { "const": "local_disk" },
              "localDisk": {
                "properties": {
                  "persistence": {
                    "properties": {
                      "enabled": { "const": true },
                      "accessModes": { "not": { "contains": { "const": "ReadWriteMany" } } }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "strategy": {
            "anyOf": [
              { "properties": { "type": { "const": "Recreate" } }, "required": ["type"] },
              {
                "properties": {
                  "type": { "const": "RollingUpdate" },
                  "rollingUpdate": {
                    "properties": { "maxSurge": { "enum": [0, "0", "0%"] } },
                    "required": ["maxSurge"]
                  }
                },
                "required": ["type", "rollingUpdate"]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "Azure Blob must have an account/container and a key source.",
      "if": {
        "properties": {
          "storage": {
            "properties": { "adapter": { "const": "azure_blob" } }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "storage": {
                "properties": {
                  "azureBlob": {
                    "properties": { "key": { "minLength": 1 } },
                    "required": ["key"]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "storage": {
                "properties": {
                  "azureBlob": {
                    "properties": { "existingSecret": { "minLength": 1 } },
                    "required": ["existingSecret"]
                  }
                }
              }
            }
          },
          { "properties": { "extraEnvFrom": { "minItems": 1 } } },
          {
            "properties": {
              "extraEnv": {
                "contains": {
                  "type": "object",
                  "properties": { "name": { "const": "AZURE_STORAGE_KEY" } },
                  "required": ["name"]
                }
              }
            }
          }
        ]
      }
    },
    {
      "$comment": "An LLM credential is required, with external env mechanisms as explicit escape hatches.",
      "anyOf": [
        { "properties": { "llm": { "properties": { "apiKey": { "minLength": 1 } }, "required": ["apiKey"] } } },
        { "properties": { "llm": { "properties": { "existingSecret": { "minLength": 1 } }, "required": ["existingSecret"] } } },
        { "properties": { "envSecret": { "properties": { "AZURE_OPENAI_API_KEY": { "minLength": 1 } }, "required": ["AZURE_OPENAI_API_KEY"] } } },
        { "properties": { "envSecret": { "properties": { "AZURE_API_KEY": { "minLength": 1 } }, "required": ["AZURE_API_KEY"] } } },
        { "properties": { "extraEnvFrom": { "minItems": 1 } } },
        {
          "properties": {
            "extraEnv": {
              "contains": {
                "type": "object",
                "properties": { "name": { "enum": ["EDSPACE_LLM_API_KEY", "AZURE_OPENAI_API_KEY", "AZURE_API_KEY"] } },
                "required": ["name"]
              }
            }
          }
        }
      ]
    },
    {
      "$comment": "MailPace is the only production mailer and its API key is required.",
      "anyOf": [
        { "properties": { "mailer": { "properties": { "mailpaceApiKey": { "minLength": 1 } }, "required": ["mailpaceApiKey"] } } },
        { "properties": { "mailer": { "properties": { "existingSecret": { "minLength": 1 } }, "required": ["existingSecret"] } } },
        { "properties": { "extraEnvFrom": { "minItems": 1 } } },
        {
          "properties": {
            "extraEnv": {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "MAILPACE_API_KEY" } },
                "required": ["name"]
              }
            }
          }
        }
      ]
    },
    {
      "$comment": "Transactional email requires a verified sender address.",
      "anyOf": [
        { "properties": { "mailer": { "properties": { "fromEmail": { "minLength": 1 } }, "required": ["fromEmail"] } } },
        { "properties": { "extraEnvFrom": { "minItems": 1 } } },
        {
          "properties": {
            "extraEnv": {
              "contains": {
                "type": "object",
                "properties": { "name": { "const": "MAILER_FROM_EMAIL" } },
                "required": ["name"]
              }
            }
          }
        }
      ]
    },
    {
      "$comment": "Azure LLM deployments need an endpoint and all three deployment names.",
      "if": {
        "properties": {
          "llm": {
            "properties": { "provider": { "const": "azure" } }
          }
        }
      },
      "then": {
        "properties": {
          "llm": {
            "properties": {
              "baseUrl": { "minLength": 1 },
              "textDeployment": { "minLength": 1 },
              "smallDeployment": { "minLength": 1 },
              "embeddingDeployment": { "minLength": 1 }
            },
            "required": ["baseUrl", "textDeployment", "smallDeployment", "embeddingDeployment"]
          }
        }
      }
    }
  ]
}
