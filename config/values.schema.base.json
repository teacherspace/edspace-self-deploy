{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Hand-maintained structural half of the chart schema. gen.py merges in env/envSecret validation from contract.yaml and writes chart/edspace/values.schema.json.",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Public hostname (PHX_HOST). Required."
        },
        "checkOrigin": { "type": "string" }
      },
      "required": ["host"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "registryCredentials": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "registry": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "username": { "minLength": 1 },
          "password": { "minLength": 1 }
        },
        "required": ["username", "password"]
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "db": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string" },
            "database": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "persistence": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            },
            "resources": { "type": "object" }
          }
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "sslMode": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "autoGenerate": { "type": "boolean" },
        "secretKeyBase": { "type": "string" },
        "tokenSigningSecret": { "type": "string" },
        "releaseCookie": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "secretKeyBase": { "type": "string" },
            "tokenSigningSecret": { "type": "string" },
            "releaseCookie": { "type": "string" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "adapter": { "enum": ["local_disk", "azure_blob"] },
        "localDisk": {
          "type": "object",
          "properties": {
            "root": { "type": "string" },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" },
                "storageClass": { "type": "string" },
                "accessModes": { "type": "array", "items": { "type": "string" } },
                "existingClaim": { "type": "string" }
              }
            }
          }
        },
        "azureBlob": {
          "type": "object",
          "properties": {
            "account": { "type": "string" },
            "container": { "type": "string" },
            "key": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "azure_blob" } } },
          "then": {
            "properties": {
              "azureBlob": {
                "properties": {
                  "account": { "minLength": 1 },
                  "container": { "minLength": 1 }
                },
                "required": ["account", "container"]
              }
            }
          }
        }
      ]
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "apiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" },
        "baseUrl": { "type": "string" },
        "apiVersion": { "type": "string" },
        "textModel": { "type": "string" },
        "textDeployment": { "type": "string" },
        "smallModel": { "type": "string" },
        "smallDeployment": { "type": "string" },
        "embeddingModel": { "type": "string" },
        "embeddingDeployment": { "type": "string" }
      }
    },
    "mailer": {
      "type": "object",
      "properties": {
        "fromEmail": { "type": "string" },
        "fromName": { "type": "string" },
        "mailpaceApiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string" }
      }
    },
    "extraEnvFrom": { "type": "array" },
    "extraEnv": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" },
            "certManager": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "issuer": { "type": "string" },
                "issuerKind": { "enum": ["Issuer", "ClusterIssuer"] }
              }
            }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "probes": { "type": "object" },
    "clustering": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "strategy": { "type": "object" },
    "migrate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer" },
        "activeDeadlineSeconds": { "type": "integer" },
        "resources": { "type": "object" }
      }
    },
    "seed": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer" },
        "resources": { "type": "object" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] },
        "behavior": { "type": "object" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" },
        "automount": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "clusterDomain": { "type": "string" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "allOf": [
    {
      "$comment": "External DB requires connection details unless bundled PG is on.",
      "if": {
        "properties": {
          "db": {
            "properties": {
              "bundled": {
                "properties": { "enabled": { "const": false } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "db": {
            "anyOf": [
              { "properties": { "host": { "minLength": 1 } }, "required": ["host"] },
              { "properties": { "existingSecret": { "minLength": 1 } }, "required": ["existingSecret"] }
            ]
          }
        }
      }
    },
    {
      "$comment": "Explicit secrets are mandatory when auto-generation is off.",
      "if": {
        "properties": {
          "secrets": {
            "properties": { "autoGenerate": { "const": false } }
          }
        }
      },
      "then": {
        "properties": {
          "secrets": {
            "anyOf": [
              {
                "properties": {
                  "secretKeyBase": { "minLength": 1 },
                  "tokenSigningSecret": { "minLength": 1 }
                },
                "required": ["secretKeyBase", "tokenSigningSecret"]
              },
              {
                "properties": { "existingSecret": { "minLength": 1 } },
                "required": ["existingSecret"]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "RWO local-disk persistence cannot roll multiple replicas.",
      "if": {
        "properties": {
          "replicaCount": { "minimum": 2 },
          "storage": {
            "properties": {
              "adapter": { "const": "local_disk" },
              "localDisk": {
                "properties": {
                  "persistence": {
                    "properties": {
                      "enabled": { "const": true },
                      "accessModes": {
                        "contains": { "const": "ReadWriteOnce" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": ["replicaCount"]
      },
      "then": {
        "$comment": "Fail: use azure_blob, an RWX storage class, or replicaCount 1.",
        "not": {}
      }
    }
  ]
}
