        "OTEL_BSP_MAX_QUEUE_SIZE": {
          "type": [
            "integer",
            "string"
          ],
          "description": "OpenTelemetry batch span processor queue size."
        },
        "OTEL_BSP_SCHEDULE_DELAY_MS": {
          "type": [
            "integer",
            "string"
          ],
          "description": "OpenTelemetry batch span processor flush interval."
        },
        "OTEL_BSP_EXPORT_TIMEOUT_MS": {
          "type": [
            "integer",
            "string"
          ],
          "description": "OpenTelemetry batch span processor export timeout."
