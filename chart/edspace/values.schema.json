        },
        "LANGFUSE_SECRET_KEY": {
          "not": {},
          "description": "LANGFUSE_SECRET_KEY is a secret - set it under envSecret (or the matching structured value) instead."
        },
        "LANGFUSE_HOST": {
          "type": "string",
          "description": "Langfuse host receiving OpenTelemetry traces (your own Langfuse instance)."
        },
        "LANGFUSE_BASE_URL": {
          "type": "string",
          "description": "Langfuse REST API base URL; defaults to LANGFUSE_HOST."
        },
        "LANGFUSE_BASEURL": {
          "type": "string",
          "description": "Legacy alias of LANGFUSE_BASE_URL."
        },
        "LANGFUSE_ENVIRONMENT": {
          "type": "string",
          "description": "deployment.environment tag on emitted traces."
        },
        "LANGFUSE_RELEASE": {
          "type": "string",
          "description": "service.version tag on emitted traces."
        },
        "LANGFUSE_TIMEOUT": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Langfuse REST client timeout (ms)."
        },
        "EDSPACE_OTEL_LLM_PAYLOADS": {
          "type": "string",
