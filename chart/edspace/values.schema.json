        "LINEAR_API_KEY": {
          "not": {},
          "description": "LINEAR_API_KEY is a secret - set it under envSecret (or the matching structured value) instead."
        },
        "LINEAR_BASE_URL": {
          "type": "string",
          "description": "Linear GraphQL endpoint."
        },
        "LINEAR_FEEDBACK_TEAM_ID": {
          "type": "string",
          "description": "Linear team receiving feedback issues."
