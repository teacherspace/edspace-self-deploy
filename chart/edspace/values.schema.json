    "envSecret": {
      "type": "object",
      "description": "Extra secret environment variables (rendered into the app Secret).",
      "properties": {
        "SECRET_KEY_BASE": {
          "type": "string",
          "description": "Random string (64+ chars) used to sign/encrypt cookies and session data. Generate with scripts/generate-secrets.sh. Changing it invalidates all active sessions."
        },
        "TOKEN_SIGNING_SECRET": {
          "type": "string",
          "description": "Random string used to sign authentication tokens. Generate with scripts/generate-secrets.sh. Changing it invalidates issued tokens."
        },
        "AZURE_STORAGE_KEY": {
          "type": "string",
          "description": "Azure Blob storage account access key (azure_blob adapter)."
        },
        "EDSPACE_LLM_API_KEY": {
          "type": "string",
          "description": "API key for the configured LLM provider. Effectively required \u2014 the product's core features depend on it. (The Azure-style fallbacks AZURE_OPENAI_API_KEY / AZURE_API_KEY are also honoured.)"
        },
        "AZURE_OPENAI_API_KEY": {
          "type": "string",
          "description": "Fallback alias for EDSPACE_LLM_API_KEY (azure provider)."
        },
        "AZURE_API_KEY": {
          "type": "string",
          "description": "Second fallback alias for EDSPACE_LLM_API_KEY."
        },
        "AZURE_SPEECH_KEY": {
          "type": "string",
          "description": "Azure Cognitive Services Speech API key."
        },
        "MAILPACE_API_KEY": {
          "type": "string",
          "description": "MailPace API token. Required \u2014 the app refuses to boot in production without it. MailPace is currently the only supported email provider (see docs/limitations.md)."
        },
        "UNILOGIN_CLIENT_SECRET": {
          "type": "string",
          "description": "UniLogin OIDC client secret."
        },
        "MICROSOFT_CLIENT_SECRET": {
          "type": "string",
          "description": "Microsoft Entra ID client secret."
        },
        "PRAXIS_LICENSE_API_KEY": {
          "type": "string",
          "description": "Praxis license service API key."
        },
        "LANGFUSE_SECRET_KEY": {
          "type": "string",
          "description": "Langfuse secret key."
        },
        "LINEAR_API_KEY": {
          "type": "string",
          "description": "Linear API key for the in-app feedback integration. Leave empty to disable (feedback is then not forwarded anywhere)."
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    }
  },
  "allOf": [
    {
      "$comment": "External DB requires connection details unless bundled PG is on.",
      "if": {
        "properties": {
          "db": {
            "properties": {
              "bundled": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "db": {
            "anyOf": [
              {
                "properties": {
                  "host": {
                    "minLength": 1
                  }
                },
                "required": [
                  "host"
                ]
              },
              {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                },
                "required": [
                  "existingSecret"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "Explicit secrets are mandatory when auto-generation is off.",
      "if": {
        "properties": {
          "secrets": {
            "properties": {
              "autoGenerate": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "secrets": {
            "anyOf": [
              {
                "properties": {
                  "secretKeyBase": {
                    "minLength": 1
                  },
                  "tokenSigningSecret": {
                    "minLength": 1
                  }
                },
                "required": [
                  "secretKeyBase",
                  "tokenSigningSecret"
                ]
              },
              {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                },
                "required": [
                  "existingSecret"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "RWO local-disk persistence cannot roll multiple replicas.",
      "if": {
        "properties": {
          "replicaCount": {
            "minimum": 2
          },
          "storage": {
            "properties": {
              "adapter": {
                "const": "local_disk"
              },
              "localDisk": {
                "properties": {
                  "persistence": {
                    "properties": {
                      "enabled": {
                        "const": true
                      },
                      "accessModes": {
                        "contains": {
                          "const": "ReadWriteOnce"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "replicaCount"
        ]
      },
      "then": {
        "$comment": "Fail: use azure_blob, an RWX storage class, or replicaCount 1.",
        "not": {}
      }
    }
  ]
}
