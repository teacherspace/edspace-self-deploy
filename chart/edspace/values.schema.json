        "LINEAR_INTERNAL_CUSTOMER_ID": {
          "type": "string",
          "description": "Linear customer id attached to feedback issues."
        },
        "LINEAR_LABEL_BUG": {
          "type": "string",
          "description": "Linear label id applied to bug feedback."
        },
        "LINEAR_LABEL_IDEA": {
          "type": "string",
          "description": "Linear label id applied to idea feedback."
        },
        "LINEAR_LABEL_OTHER": {
          "type": "string",
          "description": "Linear label id applied to other feedback."
        },
        "SOCKET_DRAINER_BATCH_SIZE": {
          "type": [
            "integer",
            "string"
          ],
          "description": "WebSockets disconnected per batch during graceful shutdown."
