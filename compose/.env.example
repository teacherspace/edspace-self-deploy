# GENERATED FILE - edit config/contract.yaml and run `make gen`.
# Environment template for the Docker Compose deployment.
#
# Uncommented entries are required; commented entries are optional
# settings shown with their defaults. The app treats a set-but-empty
# variable as SET, so only uncomment a line when giving it a value.
# See docs/env-vars.md for the full reference.

## Core Phoenix / HTTP

# Public hostname the app is served on. Drives generated URLs and the default
# WebSocket origin check.
# Required.
# Example: edspace.school.example
PHX_HOST=

# Random string (64+ chars) used to sign/encrypt cookies and session data.
# Generate with scripts/generate-secrets.sh. Changing it invalidates all
# active sessions.
# Required.
SECRET_KEY_BASE=

# Random string used to sign authentication tokens. Generate with
# scripts/generate-secrets.sh. Changing it invalidates issued tokens.
# Required.
TOKEN_SIGNING_SECRET=

# WebSocket origin check. Unset, the app allows "//" + PHX_HOST. Set to a
# comma-separated list of origins, or "false" to disable (not recommended).
# Example: https://edspace.school.example,https://alias.school.example
# PHX_CHECK_ORIGIN=

## Database

# Set to "true" to connect to Postgres over IPv6.
# ECTO_IPV6=false

# Ecto connections per pool. Effective connections per node = POOL_SIZE x
# POOL_COUNT (default 30x2 = 60). Keep replicas x POOL_SIZE x POOL_COUNT below
# Postgres max_connections.
# POOL_SIZE=30

# Number of Ecto pools per node (see POOL_SIZE).
# POOL_COUNT=2

## File storage

# Attachment storage backend. "local_disk" stores under
# EDSPACE_FILE_STORAGE_ROOT (needs a persistent volume); "azure_blob" requires
# AZURE_STORAGE_ACCOUNT/CONTAINER/KEY — if any of the three is missing the app
# silently falls back to local disk.
# One of: local_disk, azure_blob
# EDSPACE_FILE_STORAGE_ADAPTER=local_disk

# Root directory for the local_disk adapter.
# EDSPACE_FILE_STORAGE_ROOT=/app/uploads

# Azure Blob storage account name (azure_blob adapter).
# Example: stoedspaceprod
# AZURE_STORAGE_ACCOUNT=

# Azure Blob container for uploads (must already exist).
# Example: uploads
# AZURE_STORAGE_CONTAINER=

# Azure Blob storage account access key (azure_blob adapter).
# AZURE_STORAGE_KEY=

## LLM provider

# LLM provider used for chat, generation and embeddings.
# One of: azure, openai, anthropic, google, groq, mistral, openrouter, deepseek, deepinfra, cerebras, xai, amazon_bedrock
# EDSPACE_LLM_PROVIDER=azure

# API key for the configured LLM provider. Effectively required — the
# product's core features depend on it. (The Azure-style fallbacks
# AZURE_OPENAI_API_KEY / AZURE_API_KEY are also honoured.)
# Required.
EDSPACE_LLM_API_KEY=

# Provider base URL. Required for azure (your Azure OpenAI / AI Foundry
# endpoint); usually left empty for public providers.
# Example: https://example.cognitiveservices.azure.com/
# EDSPACE_LLM_BASE_URL=

# Azure OpenAI API version, when the provider is azure.
# Example: 2024-10-21
# EDSPACE_LLM_API_VERSION=

# Main text model, "provider:model" form.
# EDSPACE_LLM_TEXT_MODEL=azure:gpt-5.6-sol

# Azure deployment name serving the main text model (azure only).
# Example: gpt-5.6-sol
# EDSPACE_LLM_TEXT_DEPLOYMENT=

# Small/fast model for lightweight tasks, "provider:model" form.
# EDSPACE_LLM_SMALL_MODEL=azure:gpt-5.6-luna

# Azure deployment name serving the small model (azure only).
# Example: gpt-5.6-luna
# EDSPACE_LLM_SMALL_DEPLOYMENT=

# Embedding model for retrieval/RAG, "provider:model" form. Must produce
# 1536-dimension vectors (database schema is fixed to 1536).
# EDSPACE_LLM_EMBEDDING_MODEL=azure:text-embedding-3-small

# Azure deployment name serving the embedding model (azure only).
# Example: text-embedding-3-small
# EDSPACE_LLM_EMBEDDING_DEPLOYMENT=

# Fallback alias for EDSPACE_LLM_API_KEY (azure provider).
# AZURE_OPENAI_API_KEY=

# Fallback alias for EDSPACE_LLM_BASE_URL (azure provider).
# AZURE_OPENAI_BASE_URL=

## Speech (Azure Cognitive Services)

# Enables speech features (STT/TTS). Requires the AZURE_SPEECH_* settings when
# enabled; the packaging sets it to "false" until an Azure Speech resource is
# provided.
# EDSPACE_SPEECH_ENABLED=false

# Azure Cognitive Services Speech API key.
# AZURE_SPEECH_KEY=

# Azure Speech resource region.
# Example: swedencentral
# AZURE_SPEECH_REGION=

# Azure Speech endpoint override.
# AZURE_SPEECH_ENDPOINT=

## Mailer

# Transactional-email backend. "mailpace" uses the MailPace HTTP API, "smtp"
# any SMTP relay, "none" disables email entirely — sign-in then uses passwords
# and/or SSO, and invitation links are shown to the inviting admin to pass on
# by hand.
# One of: mailpace, smtp, none
# MAILER_ADAPTER=mailpace

# From address for transactional email. Must be a sender address verified with
# the provider — MailPace rejects every message otherwise, and most relays
# refuse the envelope.
# Required when MAILER_ADAPTER is "mailpace" or "smtp" (blank counts as
# missing and fails at boot); not read with "none".
# Example: noreply@school.example
MAILER_FROM_EMAIL=

# From display name for transactional email.
# MAILER_FROM_NAME=EdSpace

# MailPace API token.
# Required when MAILER_ADAPTER=mailpace (the default).
MAILPACE_API_KEY=

# SMTP relay hostname. Configured explicitly, so no MX lookup is done on it.
# Required when MAILER_ADAPTER=smtp.
# Example: smtp.school.example
# MAILER_SMTP_RELAY=

# SMTP relay port. 587 is the STARTTLS submission port; use 465 together with
# MAILER_SMTP_SSL=true for implicit TLS.
# MAILER_SMTP_PORT=587

# SMTP username. Setting it flips MAILER_SMTP_AUTH to "always" — a relay given
# credentials is expected to use them.
# MAILER_SMTP_USERNAME=

# SMTP password for MAILER_SMTP_USERNAME.
# Required when MAILER_ADAPTER=smtp and MAILER_SMTP_USERNAME is set (blank
# counts as missing).
# MAILER_SMTP_PASSWORD=

# Implicit TLS from the first byte, usually on port 465. Leave false for the
# ordinary STARTTLS submission port.
# MAILER_SMTP_SSL=false

# STARTTLS policy. Mandatory by default: with "if_available" a relay that does
# not advertise STARTTLS — or anyone in the middle stripping the capability —
# gets the session in cleartext, credentials and sign-in links included. Set
# "never" only for a relay on a trusted network.
# One of: always, never, if_available
# MAILER_SMTP_TLS=always

# SMTP authentication policy. Defaults to "always" when MAILER_SMTP_USERNAME
# is set and "if_available" when it is not.
# One of: always, never, if_available
# MAILER_SMTP_AUTH=if_available

# Verify the relay's TLS certificate against the OS trust store. Setting it
# false disables verification entirely — only safe for a relay you control on
# a trusted network, never across the public internet.
# MAILER_SMTP_TLS_VERIFY=true

# Path to a PEM CA bundle to verify the relay against, for an internal CA or
# an image without an OS trust store. Boot fails if the path does not exist.
# Example: /etc/ssl/certs/internal-ca.pem
# MAILER_SMTP_CACERTFILE=

# Skip the MX lookup on MAILER_SMTP_RELAY. Set false only if you really
# pointed it at a domain rather than a host.
# MAILER_SMTP_NO_MX_LOOKUPS=true

## Authentication / OIDC

# UniLogin (Danish school SSO) OIDC client id. Leave empty to disable UniLogin
# sign-in.
# UNILOGIN_CLIENT_ID=

# UniLogin OIDC client secret.
# UNILOGIN_CLIENT_SECRET=

# UniLogin OIDC redirect URI (https://<PHX_HOST>/auth/unilogin/callback).
# UNILOGIN_REDIRECT_URI=

# UniLogin broker base URL.
# UNILOGIN_BASE_URL=https://et-broker.unilogin.dk/auth/realms/broker

# OIDC claim carrying the UniLogin user id.
# UNILOGIN_ID_CLAIM=uniid

# OIDC claim carrying the UniLogin role.
# UNILOGIN_ROLE_CLAIM=uniLoginRolle

# Microsoft Entra ID tenant ("common" allows any tenant).
# MICROSOFT_TENANT_ID=common

# Microsoft Entra ID application (client) id. Leave empty to disable Microsoft
# sign-in.
# MICROSOFT_CLIENT_ID=

# Microsoft Entra ID client secret.
# MICROSOFT_CLIENT_SECRET=

# Microsoft OIDC redirect URI (https://<PHX_HOST>/auth/microsoft/callback).
# MICROSOFT_REDIRECT_URI=

# Microsoft identity platform base URL. Unset, the app derives
# "https://login.microsoftonline.com/<MICROSOFT_TENANT_ID>/v2.0" from
# MICROSOFT_TENANT_ID; set this only for a cloud whose endpoint differs (US
# Gov, China 21Vianet) or an internal proxy.
# MICROSOFT_BASE_URL=

# Praxis/Egmont OIDC client id (PKCE public client).
# PRAXIS_CLIENT_ID=

# Praxis OIDC redirect URI.
# PRAXIS_REDIRECT_URI=

# Praxis OIDC base URL.
# PRAXIS_BASE_URL=

# Praxis license service endpoint.
# PRAXIS_LICENSE_SERVICE_URL=

# Praxis license service API key.
# PRAXIS_LICENSE_API_KEY=

# Praxis product URL used in license redirects.
# PRAXIS_PRODUCT_URL=

# Comma-separated emails granted platform-admin on reconciliation. This is the
# first-admin bootstrap: a fresh install has no account that can reach the
# backoffice, so set this and then run `bin/edspace rpc
# 'Edspace.Accounts.AdminReconciler.bootstrap() |> IO.inspect(pretty: true)'`
# inside the app container. With email disabled, the result contains
# onboarding links to hand over securely. Additive only — it never demotes an
# existing admin. Read on the serving node.
# Required when bootstrapping the first platform admin on a fresh install.
# Example: admin@school.example,head@school.example
# EDSPACE_PLATFORM_ADMINS=

## Member retention & purge

# Deployment-side kill switch for the nightly member-purge sweep. Set "false"
# to stop it without a deploy — the worker then discards, and nothing inside
# the application can re-enable it.
# MEMBER_PURGE_ENABLED=true

## PDF export

# Enables the headless-Chromium PDF export subsystem. The packaging layer
# forces "false" in migration/seed jobs.
# PDF_ENABLED=true

# Concurrent Chromium sessions for PDF rendering. Each session costs memory;
# lower it on small instances.
# CHROMIC_PDF_POOL_SIZE=4

## Telemetry (Langfuse / OpenTelemetry)

# Langfuse public key. LLM tracing activates only when LANGFUSE_PUBLIC_KEY,
# LANGFUSE_SECRET_KEY and LANGFUSE_HOST are all set; leave empty to disable
# tracing.
# LANGFUSE_PUBLIC_KEY=

# Langfuse secret key.
# LANGFUSE_SECRET_KEY=

# Langfuse host receiving OpenTelemetry traces (your own Langfuse instance).
# Example: https://langfuse.school.example
# LANGFUSE_HOST=

# Langfuse REST API base URL — the read/query side (prompt fetches, usage and
# fair-use lookups), separate from the OTLP span exporter. Falls back to
# LANGFUSE_HOST, so one host variable can drive both the push and pull paths,
# and then to Langfuse's public cloud: an install that sets
# LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY without either host variable
# sends its queries to cloud.langfuse.com. Point this at your own instance, or
# leave all three unset.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# deployment.environment tag on emitted traces.
# Example: production
# LANGFUSE_ENVIRONMENT=

# service.version tag on emitted traces.
# LANGFUSE_RELEASE=

# Whether prompt/completion text is included in telemetry spans. Set to "none"
# to strip payloads (recommended when traces leave your infrastructure).
# EDSPACE_OTEL_LLM_PAYLOADS=raw

## Deployment settings (not read by the app)

# Password for the bundled Postgres (compose only). Feeds the composed
# DATABASE_URL. Generate with scripts/generate-secrets.sh.
# Required.
POSTGRES_PASSWORD=

# App image reference (compose only).
# EDSPACE_IMAGE=edspace.azurecr.io/edspace/edspace

# App image tag (compose only). Pin to a release tag.
# Required.
# Example: v1.0.0
EDSPACE_IMAGE_TAG=

# Host port the app is published on (compose only).
# EDSPACE_PORT=4000

